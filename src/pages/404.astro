---
import Base from "../layouts/Base.astro";
---

<Base title="Page not found">
  <div class="narrow" style="padding: 96px 0; text-align: center">
    <p class="eyebrow">404</p>
    <h1 style="font-size: 40px; margin: 12px 0">This page doesn't exist</h1>
    <p style="color: var(--muted); margin-bottom: 24px">It may have moved. Try the home page or the blog.</p>
    <a class="btn primary" href="/">Back home</a>
  </div>
</Base>
