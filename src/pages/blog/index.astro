---
import { getCollection } from "astro:content";
import PostCard from "../../components/PostCard.astro";
import Base from "../../layouts/Base.astro";

const posts = (await getCollection("blog", (p) => import.meta.env.DEV || !p.data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<Base title="Blog" description="Security write-ups, CTF walkthroughs and notes from building things.">
  <div class="wrap">
    <div class="page-head">
      <p class="eyebrow">Blog</p>
      <h1>Notes & write-ups</h1>
      <p>CTF walkthroughs, security notes and lessons from building things.</p>
    </div>

    <div class="grid" style="padding-bottom: 72px">
      {posts.map((p) => <PostCard post={p} />)}
    </div>
  </div>
</Base>
